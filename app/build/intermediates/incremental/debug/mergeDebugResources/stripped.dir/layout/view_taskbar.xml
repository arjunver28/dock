<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/taskbarContainer"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:background="@drawable/bg_taskbar_dock"
    android:elevation="16dp">

    <!-- Section 1: Aesthetic Mini App Drawer Button -->
    <ImageButton
        android:id="@+id/btnAppDrawer"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_button_circle_ripple"
        android:src="@drawable/ic_app_drawer_aesthetic"
        android:padding="9dp"
        android:scaleType="fitCenter"
        android:contentDescription="All Apps" />

    <!-- The Single Vertical Glass Separator between Menu Button & Fixed Apps -->
    <View
        android:id="@+id/dividerMenu"
        android:layout_width="1.2dp"
        android:layout_height="22dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:background="#20FFFFFF" />

    <!-- Section 2: Pinned Home Tray Apps -->
    <LinearLayout
        android:id="@+id/layoutPinnedApps"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical" />

    <!-- Section 3: Dynamic Recent Apps (Directly following pinned apps) -->
    <LinearLayout
        android:id="@+id/layoutRecentApps"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical" />

</LinearLayout>
