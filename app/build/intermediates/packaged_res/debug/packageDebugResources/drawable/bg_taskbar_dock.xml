<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Layer 1: Soft Ambient Shadow -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <solid android:color="#28000000" />
        </shape>
    </item>

    <!-- Layer 2: Deep Dark Translucent Smoked Glass Body (No White Tint) -->
    <item
        android:top="1dp"
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="27dp" />
            <solid android:color="#C8121418" />
            <!-- Ultra-subtle dark glass perimeter outline -->
            <stroke
                android:width="1dp"
                android:color="#1AFFFFFF" />
        </shape>
    </item>

</layer-list>
